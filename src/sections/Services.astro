---
import { services } from '../data/site';
---
<section id="servicos" class="services" aria-labelledby="services-title">
  <div class="container services__grid">
    <header class="section-head services__head">
      <p class="section-head__label">O que fazemos</p>
      <h2 id="services-title" class="section-head__title" data-reveal="lines">Estratégia, estética e código no mesmo lugar.</h2>
    </header>

    <!-- Acordeão nativo com <details>: abre e fecha sem JavaScript e é acessível por teclado -->
    <div class="services__list">
      {services.map((s, i) => (
        <details class="service" name="services" open={i === 0}>
          <summary class="service__summary">
            <span class="service__name"><span class="service__slash">//</span> {s.name}</span>
            <span class="service__icon" aria-hidden="true"></span>
          </summary>
          <div class="service__body">
            <p class="service__text">{s.summary}</p>
            <ul class="service__tags">
              {s.tags.map((t) => <li>{t}</li>)}
            </ul>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .services { padding-block: var(--space-section); background: var(--color-surface); }
  .services__grid { display: grid; grid-template-columns: 5fr 7fr; gap: var(--gutter); align-items: start; }
  .services__head { position: sticky; top: calc(3.5rem + var(--space-8)); }
  .services__list { border-top: 1px solid var(--color-line); }
  .service { border-bottom: 1px solid var(--color-line); interpolate-size: allow-keywords; }
  .service__summary {
    list-style: none; cursor: pointer;
    display: flex; justify-content: space-between; align-items: center; gap: var(--space-4);
    padding-block: var(--space-6);
  }
  .service__summary::-webkit-details-marker { display: none; }
  .service__name {
    font-family: var(--font-heading); text-transform: none; letter-spacing: -0.03em; line-height: 1;
    font-size: var(--text-xl); color: var(--color-text-strong);
  }
  .service__slash { color: var(--color-text-muted); font-variation-settings: 'wght' 200; }
  .service__icon { position: relative; width: 14px; height: 14px; flex-shrink: 0; }
  .service__icon::before, .service__icon::after {
    content: ''; position: absolute; inset: 6px 0 auto; height: 1px; background: var(--color-text-strong);
    transition: transform 0.4s var(--ease-out);
  }
  .service__icon::after { transform: rotate(90deg); }
  .service[open] .service__icon::after { transform: rotate(0deg); }

  /* Abertura animada com CSS moderno (navegadores sem suporte simplesmente abrem direto) */
  .service::details-content {
    block-size: 0; overflow: hidden;
    transition: block-size 0.5s var(--ease-out), content-visibility 0.5s allow-discrete;
  }
  .service[open]::details-content { block-size: auto; }

  .service__body { padding-bottom: var(--space-8); display: grid; gap: var(--space-6); max-width: 60ch; }
  .service__text { font-size: var(--text-sm); }
  .service__tags { display: flex; flex-wrap: wrap; gap: var(--space-2); list-style: none; }
  .service__tags li {
    font-size: var(--text-xs); padding: var(--space-1) var(--space-3);
    border: 1px solid var(--color-line); background: var(--color-bg); color: var(--color-text);
  }
  @media (max-width: 860px) {
    .services__grid { grid-template-columns: 1fr; }
    .services__head { position: static; margin-bottom: var(--space-8); }
  }
</style>
