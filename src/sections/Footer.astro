---
import { contact } from '../data/site';
const year = new Date().getFullYear();
---
<footer id="contato" class="footer" aria-labelledby="footer-title">
  <div class="container">
    <div class="footer__top">
      <h2 id="footer-title" class="footer__cta" data-reveal="lines">Tem uma marca para virar o jogo?</h2>
      <a class="footer__whats" href={contact.whatsapp} target="_blank" rel="noopener">Conversar no WhatsApp ↗</a>
    </div>

    <div class="footer__grid">
      <div class="footer__col">
        <p class="footer__label">E-mail</p>
        <button class="footer__copy" type="button" data-copy={contact.email}>
          <span data-copy-label>{contact.email}</span>
        </button>
      </div>
      <div class="footer__col">
        <p class="footer__label">Telefone</p>
        <a href={contact.whatsapp} target="_blank" rel="noopener">{contact.phone}</a>
      </div>
      <div class="footer__col">
        <p class="footer__label">Endereço</p>
        <address>{contact.address.map((l) => <span>{l}</span>)}</address>
      </div>
      <div class="footer__col">
        <p class="footer__label">Redes</p>
        <a href={contact.instagram} target="_blank" rel="noopener">Instagram</a>
        <a href={contact.linkedin} target="_blank" rel="noopener">LinkedIn</a>
        <a href={contact.labs} target="_blank" rel="noopener">LA/BS®</a>
      </div>
    </div>
  </div>

  <p class="footer__wordmark" aria-hidden="true" data-wordmark>Paradoxal</p>

  <div class="container footer__legal">
    <p>Studio Paradoxal © {year}</p>
    <p>Todos os direitos reservados</p>
  </div>
</footer>

<style>
  .footer { padding-top: var(--space-section); border-top: 1px solid var(--color-line); overflow: hidden; }
  .footer__top { display: flex; justify-content: space-between; align-items: end; gap: var(--space-8); flex-wrap: wrap; margin-bottom: var(--space-16); }
  .footer__cta { font-size: var(--text-xl); font-weight: 400; max-width: 16ch; }
  .footer__whats { font-size: var(--text-sm); color: var(--color-text-strong); border-bottom: 1px solid var(--color-text-strong); padding-bottom: 2px; }
  .footer__grid {
    display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--gutter);
    padding-block: var(--space-8); border-top: 1px solid var(--color-line);
    font-size: var(--text-xs);
  }
  .footer__col { display: grid; align-content: start; gap: var(--space-2); }
  .footer__col a, .footer__copy { justify-self: start; transition: color 0.2s; }
  .footer__col a:hover, .footer__copy:hover { color: var(--color-text-strong); }
  .footer__label { color: var(--color-text-muted); margin-bottom: var(--space-2); }
  .footer__col address { font-style: normal; display: grid; }
  .footer__copy { text-align: left; border-bottom: 1px dashed var(--color-line); }
  .footer__wordmark {
    font-family: var(--font-heading); text-transform: none; text-align: center;
    font-size: 22.5vw; line-height: 0.78; letter-spacing: -0.06em;
    color: var(--color-text-strong); font-variation-settings: 'wght' 800;
    margin-top: var(--space-12); white-space: nowrap;
  }
  .footer__legal {
    display: flex; justify-content: space-between; padding-block: var(--space-6);
    font-size: var(--text-xs); color: var(--color-text-muted);
  }
  @media (max-width: 860px) { .footer__grid { grid-template-columns: 1fr 1fr; row-gap: var(--space-8); } }
  @media (max-width: 480px) { .footer__grid { grid-template-columns: 1fr; } .footer__legal { flex-direction: column; gap: var(--space-1); } }
</style>
