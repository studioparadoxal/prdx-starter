---
import { cases } from '../data/site';
---
<section id="cases" class="cases" aria-labelledby="cases-title">
  <div class="container">
    <header class="section-head">
      <p class="section-head__label">Cases selecionados</p>
      <h2 id="cases-title" class="section-head__title" data-reveal="lines">Marcas que a gente construiu do zero.</h2>
    </header>

    <ul class="cases__list" data-cases>
      {cases.map((c) => (
        <li class="cases__row">
          <a href={c.href} class="cases__link" data-case data-tone={c.tone}>
            <span class="cases__name">{c.name}</span>
            <span class="cases__tags">{c.tags.join(' / ')}</span>
            <span class="cases__arrow" aria-hidden="true">↗</span>
          </a>
        </li>
      ))}
    </ul>
  </div>

  <!-- Imagem que segue o cursor no hover (só em dispositivos com mouse). PLACEHOLDER até chegarem as fotos. -->
  <div class="cases__preview" data-case-preview aria-hidden="true">
    <span>Imagem do case</span>
  </div>
</section>

<style>
  .cases { padding-block: var(--space-section); }
  .cases__list { list-style: none; border-top: 1px solid var(--color-line); }
  .cases__row { border-bottom: 1px solid var(--color-line); }
  .cases__link {
    display: grid; grid-template-columns: 1fr auto auto; align-items: baseline; gap: var(--space-8);
    padding-block: var(--space-8);
  }
  .cases__name {
    font-family: var(--font-heading); text-transform: none; letter-spacing: -0.035em; line-height: 1;
    font-size: var(--text-2xl); color: var(--color-text-strong);
    font-variation-settings: 'wght' 300;
    transition: font-variation-settings 0.5s var(--ease-out);
  }
  .cases__tags { font-size: var(--text-xs); color: var(--color-text-muted); text-align: right; }
  .cases__arrow { font-size: var(--text-lg); transition: transform 0.4s var(--ease-out); }
  @media (hover: hover) {
    .cases__link:hover .cases__name { font-variation-settings: 'wght' 700; }
    .cases__link:hover .cases__arrow { transform: translate(4px, -4px); }
    .cases__list:hover .cases__link:not(:hover) { opacity: 0.35; }
    .cases__link { transition: opacity 0.4s var(--ease-out); }
  }
  .cases__preview {
    position: fixed; top: 0; left: 0; z-index: 40; pointer-events: none;
    width: clamp(220px, 22vw, 360px); aspect-ratio: 4 / 5;
    display: grid; place-items: center;
    background: var(--tone, var(--color-surface));
    font-size: var(--text-xs); color: var(--color-text);
    opacity: 0; scale: 0.85;
    transition: opacity 0.3s var(--ease-out), scale 0.4s var(--ease-out), background-color 0.3s;
  }
  .cases__preview.is-active { opacity: 1; scale: 1; }
  @media (hover: none) { .cases__preview { display: none; } }
  @media (max-width: 640px) {
    .cases__link { grid-template-columns: 1fr auto; row-gap: var(--space-3); }
    .cases__tags { grid-column: 1; grid-row: 2; text-align: left; }
  }
</style>
